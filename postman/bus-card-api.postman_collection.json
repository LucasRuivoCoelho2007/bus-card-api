          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\n\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Token is present and stored in environment\", function () {\n    pm.expect(response.message.token).to.be.a('string');\n    pm.environment.set(\"token\", response.message.token);\n});\n"
                ]
              }
            }
          ],
